# Perf scope: layered on top of sdkconfig.defaults.diag (and, for a real
# capture, sdkconfig.defaults.diag_autorun as well) by
# report_performance.sh --perf-scope and capture_ref.sh --perf-scope. Nothing
# layers it by default, so an ordinary --diag build still carries every suite.
#
# It compiles in only what a sand frame-budget capture reads: suite_sand_perf
# plus the scene builders it calls. That frees the static RAM a round needs
# for its own pass gates and probe rows, cuts the on-device
# run, and puts the image closer to release layout in the instruction cache.
#
# BEHAVIOUR COVERAGE IS DELIBERATELY ABSENT HERE. This is an instrument, not a
# gate: never take a merge decision from a build that layers this file.
CONFIG_LAUNCHER_SELFTEST_SCOPE_PERF=y
