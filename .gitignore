### Claude Code
.claude/

### ESP-IDF
build/
# Variant build directories, e.g. build.diag from test/run_device_tests.sh.
# Each variant keeps its own sdkconfig so it never disturbs the normal build.
build.*/
managed_components/
dependencies.lock
sdkconfig.old

# idf.py clang-check output - see launcher/.clang-tidy
warnings.txt
html_report/

# Real-hardware sweep scratch output (CSVs, raw serial captures) - see
# launcher/tools/sweeps/README.md. The scripts themselves are tracked.
launcher/tools/sweeps/results/

# Same idea for tools/report_test_results.sh - generated reports and raw
# captures, not something to commit.
launcher/tools/results/

# Same idea again for each app's own tools/ (e.g.
# launcher/main/apps/sand/tools/report_performance.sh) - an app-owned tool's
# scratch output belongs under the app, not shared tools/, so it is
# gitignored by the same pattern rather than listed per app.
launcher/main/apps/*/tools/results/

# Captured .bmp files from tools/screenshot.sh - scratch output, not
# something to commit.
launcher/tools/screenshots/

### Windows
# Windows thumbnail cache files
Thumbs.db

# Folder config file
[Dd]esktop.ini

# Recycle Bin used on file shares
$RECYCLE.BIN/

# Windows shortcuts
*.lnk

### VS Code
# VSCode settings (keep shared configuration)
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# Local History for Visual Studio Code
.history/

# Built Visual Studio Code Extensions
*.vsix

### Beads (bd issue tracker) — local backlog DB, not versioned
.beads/
# scripts/perf-loop.sh working area: logs, per-candidate reports and the
# quarantine pile. Regenerated per run, never worth committing.
.perf-loop/

# Structured prompts for handing work to another session or a local model.
# Working notes, revised per round - not part of the shipped project.
.prompts/
